# Copy to .env and choose a local password. Compose reads .env automatically.
MATRIX_DB_LOCAL_PASSWORD=replace-with-local-password
MATRIX_DB_LOCAL_PORT=5432
# Export this separately for the Python CLI; .env is not automatically loaded by Python.
MATRIX_DB_DATABASE_URL=postgresql://matrix:replace-with-local-password@127.0.0.1:5432/matrix

# Shared POSIX chunk-storage directory, independent of the PostgreSQL volume.
MATRIX_DB_ARRAY_ROOT=./array-data

# Export a JSON array of service credentials before running the API or worker.
# Generate random tokens; this is a configuration placeholder, not a usable key.
# MATRIX_DB_API_KEYS=[{"token":"REPLACE_WITH_A_RANDOM_32_BYTE_TOKEN","subject":"geosentinel","role":"reader","datasets":["demo-weather"]}]
